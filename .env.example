# Google Gemini API Key (Server-side only, never expose on client)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Supabase configuration (if not provided, Fluent IQ automatically runs in persistent local browser demo mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

